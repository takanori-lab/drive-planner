{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drive-planner-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-17",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": ["DRIVE_PLANNER_PASSCODE", "SESSION_SIGNING_KEY", "OPENAI_API_KEY"]
  },
  "ratelimits": [
    {
      "name": "SESSION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
