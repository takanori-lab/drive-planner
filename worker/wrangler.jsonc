{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drive-planner-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-17",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": ["DRIVE_PLANNER_PASSCODE", "SESSION_SIGNING_KEY", "OPENAI_API_KEY", "AI_LOG_EXPORT_KEY"]
  },
  "d1_databases": [
    {
      "binding": "AI_LOGS_DB",
      "database_name": "drive-planner-ai-logs",
      "database_id": "9cd33a62-b3f3-4244-b7d1-82fcdca389e4"
    }
  ],
  "ratelimits": [
    {
      "name": "SESSION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
